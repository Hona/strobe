{
  "name": "@hona/strobe-bench",
  "version": "0.1.1",
  "description": "Types and helpers for strobe bench files: measure web pages, Electron apps and scripts with paired, valid statistics",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm && tsc -p tsconfig.json",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": ["benchmark", "performance", "strobe", "playwright", "electron", "chromium"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
